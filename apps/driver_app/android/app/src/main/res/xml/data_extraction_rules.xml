<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. The app keeps the 30-day sign-in token and the rider's profile in app storage,
     so nothing is copied to cloud backups or to a new phone: the rider logs in again with phone + password. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
